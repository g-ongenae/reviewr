# Copy to .env and adjust.
DATABASE_URL=postgres://reviewr:reviewr@localhost:5432/reviewr
# Interface to listen on (127.0.0.1 when behind a reverse proxy such as `tailscale serve`).
HOST=0.0.0.0
PORT=3000
# Comma-separated list of origins allowed by CORS (the web app in dev). Use * to allow any.
CORS_ORIGIN=http://localhost:5173
# Apply pending database migrations when the API boots.
RUN_MIGRATIONS=true
