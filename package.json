{
  "name": "reviewr",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d postgres",
    "dev:api": "pnpm --filter @reviewr/api dev",
    "dev:web": "pnpm --filter @reviewr/web dev",
    "dev:mobile": "pnpm --filter @reviewr/mobile start"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  }
}
